PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=construction_erp
DB_USER=root
DB_PASSWORD=
# Managed MySQL (Aiven etc.) requires TLS. Set DB_SSL=true and paste the
# provider's CA certificate into DB_SSL_CA, or give a path to the .pem file.
DB_SSL=false
DB_SSL_CA=
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=8h
UPLOAD_DIR=uploads
